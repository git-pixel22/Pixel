# Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# LLM Configuration (Uncomment and configure when ready)
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_PROVIDER=openai  # Options: openai, anthropic
# LLM_MODEL=gpt-4  # or claude-3-5-sonnet-20241022

# CORS Configuration
CORS_ORIGINS=*  # Comma-separated list for production: https://yourapp.com,https://www.yourapp.com

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Rate Limiting (optional - implement if needed)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600